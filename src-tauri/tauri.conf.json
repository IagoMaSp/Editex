{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Editex",
  "version": "0.1.0",
  "identifier": "dev.iagomasp.editex",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Editex",
        "width": 1440,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "homepage": "https://github.com/IagoMaSp/Editex",
    "longDescription": "Editor LaTeX de escritorio, local y rápido: compilación con latexmk, visor PDF con SyncTeX, autocompletado con texlab y corrector ortográfico.",
    "category": "Productivity",
    "shortDescription": "Editor LaTeX de escritorio",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
